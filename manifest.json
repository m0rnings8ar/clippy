{
  "manifest_version": 3,
  "name": "Clippy — Clipboard & Snippets",
  "version": "1.0.0",
  "description": "Clipboard history, a snippet library with dynamic variables, text cleanup and site-aware suggestions. Everything stays on your device.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clippy",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "clipboardRead", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["lib/search.js", "lib/templates.js", "lib/cleanup.js", "lib/sensitive.js", "lib/defaults.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "open-palette": {
      "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space" },
      "description": "Open the snippet & clipboard palette"
    },
    "paste-clean": {
      "suggested_key": { "default": "Alt+Shift+V", "mac": "Alt+Shift+V" },
      "description": "Paste the clipboard with your default cleanup applied"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C", "mac": "Alt+Shift+C" }
    }
  }
}
